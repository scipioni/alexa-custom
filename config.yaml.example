# config.yaml — unified configuration for alexa-custom
#
# Copy this file to config.yaml and fill in your values.
# config.yaml is hot-reloaded: save the file and changes apply within ~4 seconds.

# ---------------------------------------------------------------------------
# env: — environment variables (credentials and runtime settings)
# ---------------------------------------------------------------------------
# Values are written into the process environment on startup and on every
# hot-reload. Keys and values must be strings.

env:
  # --- LiveKit (required) ---
  LIVEKIT_URL: wss://your-project.livekit.cloud
  LIVEKIT_ROOM: your-room-name
  LIVEKIT_API_KEY: your-api-key
  LIVEKIT_API_SECRET: your-api-secret

  # --- Audio devices ---
  # Substring of the PipeWire/ALSA device name, or a sounddevice index.
  # Omit to use system defaults.
  INPUT_DEVICE: pipewire
  OUTPUT_DEVICE: pipewire

  # --- WebRTC microphone processing (all default to 1 = enabled) ---
  #MIC_AGC: 1                 # Automatic Gain Control
  #MIC_AEC: 1                 # Acoustic Echo Cancellation
  #MIC_NOISE_SUPPRESSION: 1   # Noise suppression
  #MIC_HIGH_PASS_FILTER: 1    # High-pass filter (removes low-frequency rumble)

  # --- Vosk STT model ---
  # Path to the Vosk model directory. Run 'alexa-setup' to download it.
  #VOSK_MODEL_PATH: models/it

  # --- Piper TTS voices ---
  # Directory where Piper .onnx voice files are stored. Default: models/piper
  # Voices are downloaded by 'alexa-setup --piper-voice <name>'.
  #PIPER_VOICES_DIR: models/piper

  # --- Audio interaction tuning (all optional, sensible defaults applied) ---
  # Time the STT gate stays held after a playback subprocess exits, to let
  # PipeWire/ALSA buffers drain and the acoustic echo decay.
  #AUDIO_POST_PLAYBACK_MS: 100
  # Silence prepended to short tones/beeps so the PortAudio stream finishes
  # cold-start before the audible part begins.
  #AUDIO_TONE_PREROLL_MS: 300
  # Idle time after which the STT capture considers the user has stopped
  # speaking (VAD endpoint). Lower = snappier replies; higher = better for
  # users who pause mid-sentence.
  #STT_VAD_SILENCE_MS: 700

  # --- Empty room timeout ---
  # Disconnect from LiveKit if the room has no other participants for this
  # many seconds. Set to 0 or omit to stay connected indefinitely.
  #EMPTY_ROOM_TIMEOUT: 30

  # --- Telegram (required for 'telegram' action type) ---
  #TELEGRAM_BOT_TOKEN: "123456789:AABBccDDeeFFggHH-your-token-here"
  #TELEGRAM_CHAT_ID: "123456789"

  # --- MQTT / Home Assistant ---
  # MQTT_HOST is required to enable MQTT. All other values have defaults.
  #MQTT_HOST: 127.0.0.1
  #MQTT_PORT: 1883
  #MQTT_TOPIC_PREFIX: alexa
  #MQTT_NODE_ID: living_room   # defaults to system hostname

# ---------------------------------------------------------------------------
# web: — browser dashboard (optional)
# ---------------------------------------------------------------------------
# Dashboard is served automatically. Use --web-port to change the port.
# The dashboard is served at http://<host>:PORT/ — no authentication,
# bind to LAN interfaces only.

#web:
#  port: 8080    # HTTP / WebSocket port (default: 8080)

# ---------------------------------------------------------------------------
# Audio hardware settings (all optional — defaults match Arduino Uno Q / NewPie)
# ---------------------------------------------------------------------------

# Name substring used to identify the audio card in PipeWire/ALSA.
# Change this if you are using a different USB speakerphone.
#audio_card_name: NewPie

# Sample rates by connection type (Hz). Lower rates reduce CPU on weak hardware.
#audio_sample_rates:
#  usb: 48000
#  bluetooth: 16000
#  internal: 48000

# How long (ms) the STT gate stays held after playback ends, to let
# PipeWire/ALSA buffers drain and acoustic echo decay.
# (also settable via AUDIO_POST_PLAYBACK_MS env var; env wins if both set)
#audio_post_playback_ms: 100

# Silence (ms) prepended to tones/beeps so the PipeWire sink finishes
# cold-start before the audible part begins.
# (also settable via AUDIO_TONE_PREROLL_MS env var; env wins if both set)
#audio_tone_preroll_ms: 300

# Microphone hardware gain applied during 'task audio:setup' (percent).
# 300 = 3× boost. Has no effect unless you re-run 'task audio:setup'.
#audio_mic_gain: 300

# ---------------------------------------------------------------------------
# STT sensitivity tuning (all optional)
# (corresponding env vars still override when set)
# ---------------------------------------------------------------------------

# Silence after speech (ms) that ends the command capture window.
# Lower = faster replies; higher = better for users who pause mid-sentence.
# (also settable via STT_VAD_SILENCE_MS env var; env wins if both set)
#stt_vad_silence_ms: 700

# Silence after speech (ms) in stage-1 wake-word detection before force-finalizing.
# (also settable via STT_STAGE1_VAD_SILENCE_MS env var; env wins if both set)
#stt_stage1_vad_silence_ms: 500

# Minimum RMS energy above which audio is considered speech in stage-1.
# (also settable via STT_STAGE1_RMS_THRESHOLD env var; env wins if both set)
#stt_stage1_rms_threshold: 0.02

# ---------------------------------------------------------------------------
# Connection and queue settings (all optional)
# ---------------------------------------------------------------------------

# Seconds between LiveKit reconnect attempts after a disconnection.
#reconnect_delay: 5

# Maximum number of outgoing MQTT messages to queue while the broker is
# unreachable. When full, the oldest message is dropped.
#mqtt_queue_max: 200

# How often the config.yaml watcher polls for changes (seconds).
#config_poll_interval: 2

# ---------------------------------------------------------------------------
# actions_file: — external trigger/action definitions (agent-writable)
# ---------------------------------------------------------------------------
# Move all triggers and wake-word-specific trigger lists into actions.yaml.
# The learning agent appends new commands there automatically.
# Omit this key to keep triggers inline in this file (backward-compatible).

actions_file: actions.yaml

# ---------------------------------------------------------------------------
# llm: — Ollama-backed free-form voice AI (optional)
# ---------------------------------------------------------------------------
# When configured, unmatched commands are routed to the Ollama conversation
# engine instead of playing the timeout beep.
# Requires a running Ollama instance accessible at the configured host URL.

#llm:
#  backend: ollama
#  host: http://192.168.1.10:11434   # Ollama server URL (remote only)
#  model: ssfdre38/gemma4-nano        # model name as shown by 'ollama list'
#  context_turns: 10                 # exchange pairs kept in conversation history
#  context_window_secs: 60           # seconds of inactivity before history resets
#  fallback_on_no_match: false       # route unmatched commands to LLM (default: false)
#  learn_commands: true              # enable llm_learn action type
#  request_timeout: 60.0             # read timeout for LLM inference (connect timeout is always 5 s)
#  # system_prompt: null             # optional override for the default system prompt
#  exit_phrases:                     # phrases that immediately end the conversation
#    - stop                          # (replaces defaults when set)
#    - basta
#    - esci
#    - fine
#    - fermati
#    - chiudi
#    - exit
#    - quit
#    - annulla
#    - cancella

# ---------------------------------------------------------------------------
# Wake words
# ---------------------------------------------------------------------------
# Each group has a primary word, optional aliases, an optional lang tag for
# the LLM conversation language, and an optional per-group trigger list.
# If a group defines no triggers, the global top-level triggers list is used.
# With actions_file configured, triggers can also live in actions.yaml.
#
# For emergency wake words, prefer multi-word phrases (e.g. "aiuto aiuto") so
# a single utterance does not trigger the assistant. The component words are
# automatically added as confusers — Vosk can recognise them but will not
# trigger command mode.
#
# confusers: (optional) extra phrases added to the Vosk stage-1 grammar so
# that phonetically similar words are recognised and rejected rather than
# misidentified as the wake word. Automatic confusers (sub-phrase decomposition
# and phonetic distance) are computed at startup unless auto_confusers is false.
#
# Example for an emergency-use assistant:
#   wake_words:
#     - word: "aiuto aiuto"
#       aliases:
#         - "aiutami"
#         - "mi serve aiuto"
#       # "aiuto" (single word) is added automatically as a confuser
#       confusers:
#         - "arduino"         # manual domain-specific confuser

wake_words:
  - word: "galileo"
    aliases:
      - "ehi galileo"       # alternative recognition phrase for the same group
    #confusers:
    #  - "arduino"           # words to add to grammar and silently reject
    lang: "it-IT"           # BCP-47 language used by the LLM conversation engine
    triggers:               # commands active only after this wake word
      - phrase: "chiama stefano"
        actions:
          - type: ask
            text: "Vuoi chiamare Stefano?"
            lang: "it-IT"   # BCP-47 language tag for TTS (default: it-IT)
            timeout: 5.0    # seconds to wait for a reply
            on_reply:
              - phrase: "si"
                actions:
                  - type: say
                    text: "Sto chiamando Stefano"
                  - type: livekit_join
                  - type: telegram
                    text: "Collegati con casa <room>"
                    # chat_id: "123456789"  # overrides TELEGRAM_CHAT_ID env var
              - phrase: "no"
                actions:
                  - type: say
                    text: "Chiamata annullata"
            on_else:        # actions when no reply phrase matches (or timeout)
              - type: say
                text: "Non ho capito"

  # This group has no per-group triggers — falls back to the global list below.
  - word: "assistente"
    lang: "it-IT"

# ---------------------------------------------------------------------------
# Recognition settings
# ---------------------------------------------------------------------------

# How long to listen for a command after the wake word (seconds, two-stage only).
command_timeout: 3.0

# Recognition mode:
#   two-stage    — low CPU; wake word detected first, then a timed window opens
#   single-stage — always-on transcription; say wake word + command in one phrase
recognition_mode: two-stage

# Vosk confidence threshold (0.0–1.0) to accept a wake word in two-stage mode.
wake_confidence: 0.65

# Tone name to play when a wake word is matched.
# Available names: wake, startup, success, error, info, warning (or 'none' to disable)
wake_tone: wake

# ---------------------------------------------------------------------------
# TTS — text-to-speech backend
# ---------------------------------------------------------------------------
# Two backends are available:
#   piper — neural TTS, natural voice. Default. ~60 MB model per voice.
#           Run 'alexa-setup --piper-voice <name>' to download a voice.
#           Available voices:
#             - it_IT-paola-medium    (female, default)
#             - it_IT-riccardo-x_low  (male, faster)
#   pico  — classic concatenative TTS (libttspico). Robotic but very low
#           latency and no model to download.
#
# If 'piper' is selected but unavailable (package or voice missing), the
# system automatically falls back to Pico with a warning in the log.

tts:
  backend: piper
  voice: it_IT-paola-medium
  # Silence prepended to TTS audio (ms). Covers PipeWire/PortAudio cold-start.
  # Lower = snappier responses; raise if you hear the first syllable clipped.
  preroll_ms: 400

# Legacy single-key form (still honoured, overridden by the tts: block above):
#tts_preroll_ms: 400
#tts_backend: piper
#tts_voice: it_IT-paola-medium

# ---------------------------------------------------------------------------
# STT — speech-to-text backend
# ---------------------------------------------------------------------------
# Two backends are available:
#   vosk        — default, grammar-constrained recognition (low CPU)
#   sherpa-onnx — streaming open-vocabulary model (higher CPU, better accuracy)
#
# sherpa-onnx model download:
#   python -m alexa_custom.setup --sherpa-onnx
#   (or: hf download hudaiapa88/sherpa-stt-onnx --local-dir ./models --include "it/kroko_128l/*")

stt:
  backend: vosk
  # model_path: models/it/kroko_128l  # Optional: override default model path for sherpa-onnx
  # model_path: models/it             # For vosk
  stage1:
    # auto_confusers: true        # set to false to disable all automatic confuser generation
    # confuser_distance: 3        # IPA phoneme edit distance threshold for automatic phonetic confusers
    # max_confusers: 30           # cap on total auto-generated confusers (grammar size limit)

# ---------------------------------------------------------------------------
# Startup actions
# ---------------------------------------------------------------------------
# Executed once when the daemon finishes initializing.

on_startup:
  - type: say
    text: "Sistema pronto"
    lang: "it-IT"

# ---------------------------------------------------------------------------
# Audio levels
# ---------------------------------------------------------------------------
# Output volume for the speaker (0.0–1.0, default 0.5 = 50%).
# This sets the PulseAudio software volume used by pw-play.
#output_volume: 0.5
# Input gain for the microphone (0.0–inf, default 1.0 = 100%).
# Values > 1.0 boost the microphone (e.g. 2.0 = 200%, 3.0 = 300%).
#input_gain: 1.0

# ---------------------------------------------------------------------------
# Global fallback triggers
# ---------------------------------------------------------------------------
# Used by any wake word group that defines no per-group triggers.
# All action types are shown below for reference.

triggers:
  # --- log: write a message to the application log ---
  - phrase: "test"
    actions:
      - type: log
        message: "command recognition working"

  # --- say: speak text via TTS ---
  # aliases: alternative phrasings matched with the same fuzzy scoring;
  #          the best score across phrase + aliases wins.
  - phrase: "di qualcosa"
    aliases:
      - "dimmi qualcosa"
      - "parla"
    actions:
      - type: say
        text: "Ciao dal sistema vocale"
        lang: "it-IT"

  # --- tone: play a predefined sound ---
  # Available names: startup, success, error, info, warning
  - phrase: "suona"
    actions:
      - type: tone
        name: info

  # --- shell: run a shell command ---
  - phrase: "aggiorna"
    actions:
      - type: shell
        command: "systemctl restart my-service"

  # --- livekit_join: connect to the LiveKit room ---
  - phrase: "connettiti"
    aliases:
      - "collegati"
      - "apri stanza"
    actions:
      - type: livekit_join

  # --- telegram: send a Telegram message ---
  - phrase: "manda messaggio"
    actions:
      - type: telegram
        text: "Messaggio vocale ricevuto"
        # chat_id: "123456789"  # overrides TELEGRAM_CHAT_ID env var
        # Use <room> placeholder to include a LiveKit browser join URL:
        # text: "Entra nella stanza: <room>"

  # --- mqtt_publish: publish an MQTT message ---
  - phrase: "accendi la luce"
    actions:
      - type: mqtt_publish
        topic: "home/light/set"
        payload: "ON"
        retain: false       # optional, default false

  # --- say with shell template ---
  # $(command) inside text: is replaced with the command's stdout before TTS.
  # Multiple substitutions in one string are expanded concurrently.
  - phrase: "che ora è"
    aliases:
      - "dimmi l'ora"
      - "che ore sono"
    actions:
      - type: say
        text: "$(date +'Sono le %H e %M')"

  - phrase: "che temperatura fa"
    aliases:
      - "dimmi la temperatura"
    actions:
      - type: say
        text: "La temperatura è $(cat /sys/class/thermal/thermal_zone0/temp | awk '{printf \"%.0f\", $1/1000}') gradi"

  - phrase: "da quanto tempo sei acceso"
    actions:
      - type: say
        text: "$(uptime -p | sed 's/up /Sono acceso da /')"

  # --- ask: speak a question and wait for a reply ---
  - phrase: "chiedi conferma"
    actions:
      - type: ask
        text: "Sei sicuro?"
        lang: "it-IT"
        timeout: 5.0
        on_reply:
          - phrase: "si"
            actions:
              - type: tone
                name: success
        on_else:
          - type: tone
            name: error
