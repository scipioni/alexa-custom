# production/.env — filled in by an operator on the target board, used only by
# production/Taskfile.yml (never by the apps themselves — see README.md for
# why this is a separate file from ~/apps/alexa-custom/conf/secrets.yaml).
#
# Copy to `.env` (same directory as this file) and fill in your values.
# `.env` is git-ignored; only this example is committed.

# --- Private package registry (read access — installing alexa-custom / onvif-sua) ---
# Any PyPI-compatible "simple" index: a Gitea package registry, a GitLab
# package registry, devpi, Nexus, etc. If the registry allows anonymous read,
# leave USERNAME/PASSWORD blank — they're only embedded in the index URL when set.
PYPI_INDEX_URL=
PYPI_USERNAME=
PYPI_PASSWORD=

# Version pins are NOT set here — pass them on the command line instead, e.g.:
#   task pypi:install ALEXA_CUSTOM_VERSION=0.4.1 ONVIF_SUA_VERSION=1.0.0
# Omitting them installs the latest version of each package. See README.md.
