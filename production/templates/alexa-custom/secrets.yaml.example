# ~/apps/alexa-custom/conf/secrets.yaml.example — credentials for this board's
# alexa-custom instance.
#
# Copy to secrets.yaml (task config:init does this — cp -n, never clobbers an
# existing file) and fill in your values. Never committed, never uploaded
# anywhere by the provisioning tasks.
#
# This is deliberately the same shape as the dev checkout's
# conf.example/secrets.yaml, MINUS the `pypi:` block: that block holds
# private-registry *publish* credentials, which have no reason to exist on a
# production board (boards only ever read from the registry — install
# credentials, if the registry requires them for reads, live in
# production/.env instead — see production/README.md).
#
# All values are optional; omit a section if the corresponding feature is not used.

# --- LiveKit (required for voice calls) ---
livekit:
  url: wss://your-project.livekit.cloud
  api_key: YOUR_LIVEKIT_API_KEY
  api_secret: YOUR_LIVEKIT_API_SECRET
  room: your-room-name
  # meet_url: https://meet.livekit.io  # optional — self-hosted meet frontend base URL
  #   used for the browser join link sent by the 'telegram' action (<room> placeholder)

# --- Telegram (required for 'telegram' action type) ---
telegram:
  bot_token: "123456789:AABBccDDeeFFggHH-your-token-here"
  chat_id: "123456789"

# --- LLM backend (required for llm_chat / llm_learn action types) ---
llm_host: http://127.0.0.1:11434
# llm_api_key: sk-your-api-key-here

# --- MQTT broker credentials (optional) ---
# Only needed when the broker requires authentication.
mqtt:
  # Daemon -> local broker (the local broker is anonymous, so unused today).
  username: ""
  password: ""
  # Local broker -> central master broker, used by the mosquitto bridge only
  # (rendered into /etc/mosquitto/conf.d/serena-bridge.conf by
  # `task mqtt:bridge-setup`). Not read by the Python daemon.
  bridge_username: ""
  bridge_password: ""
