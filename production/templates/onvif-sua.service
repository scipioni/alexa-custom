# systemd --user unit — installed by `task systemd:install` (see production/Taskfile.yml).
# Mirrors ../onvif_sua/onvif-sua-user.service (dev checkout layout) but points
# at the production venv installed by `task pypi:install` instead of a git
# checkout's .venv — no sudo, no dedicated system account, no /opt install.
[Unit]
Description=ONVIF/Dahua fall-detection event bridge (onvif-sua, production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/onvif-sua
ExecStart=%h/apps/onvif-sua/.venv/bin/onvif-sua
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Rome

[Install]
WantedBy=default.target
