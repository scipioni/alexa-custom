# .env — secrets for onvif-sua (camera / scan / web GUI passwords).
#
# Copy this file to `.env` (same directory as docker-compose.yml) and fill in real
# values. `.env` is git-ignored; only this example is committed. Loaded automatically
# in BOTH run modes: python-dotenv for native `uv run onvif-sua`, and `env_file: .env`
# in docker-compose.yml for Docker.
#
# PRECEDENCE: a variable already exported in the process environment WINS over the
# value here (python-dotenv is called with override=False). Unset password = the
# placeholder "default_to_change", which keeps camera workers and the manual scan
# SUPPRESSED (fail-safe) until you set a real value.

# ── Camera common credential (used by the persistent static workers) ─────────────
CAMERA_USER=admin
CAMERA_PASSWORD=default_to_change

# ── Manual subnet-scan credential ────────────────────────────────────────────────
# Optional: defaults to CAMERA_USER / CAMERA_PASSWORD when left unset.
# Also used by the automatic hostname→IP resolution sweep, which runs every 10 minutes
# when at least one settings.yaml `cameras.list` entry declares `hostname:` instead of
# `ip:` (see README, "Telecamere per hostname"). With a placeholder password that sweep
# is suppressed too, exactly like the manual scan.
#SCAN_USER=admin
#SCAN_PASSWORD=

# ── Automatic subnet rescan (default only; settings.yaml wins) ───────────────────
# Seconds that must pass SINCE THE LAST SCAN (manual or automatic) before another one
# runs. 0 = disabled, which is the default: the scanner then runs only when the
# operator asks. A non-zero value below 60 is raised to 60 — a scan authenticates
# against every host on the subnet. The authoritative place for this is
# `scan.rescan_time_interval` in settings.yaml; this env var is only the fallback.
#RESCAN_TIME_INTERVAL=0

# ── Web GUI login password ───────────────────────────────────────────────────────
# Plaintext; hashed in memory at startup. To change it, edit this value and restart
# (there is no in-GUI change-password anymore).
GUI_PASSWORD=change-me

# Set to true to bypass the /login page entirely (every page behaves as already
# authenticated) — e.g. when a reverse proxy already handles auth. Default false.
# settings.yaml `web.skip_login` overrides this when present.
#GUI_SKIP_LOGIN=false

# ── Serena voice-assistant bridge (opt-in) ─────────────────────────────────────────
# Defaults for the settings.yaml `serena:` block (settings.yaml wins when present).
# Booleans accept 1/true/yes/on (case-insensitive); anything else — incl. empty — is false.
# node_id MUST match Serena's node_id (its hostname or state.yaml override) or nothing
# arrives. announce_fault_interval_s has a 30s floor; announce_fault_grace_s=0 disables
# the startup/flap suppression window (may produce a false "non attivo" at startup).
#SERENA_ENABLED=false
#SERENA_TOPIC_PREFIX=alexa
#SERENA_NODE_ID=
#SERENA_COMMAND_TEMPLATE=caduta_{cam_name}
#SERENA_ANNOUNCE_READY=true
#SERENA_ANNOUNCE_TEMPLATE=sensore uomo a terra {cam_name} attivo
#SERENA_ANNOUNCE_FAULT=false
#SERENA_ANNOUNCE_FAULT_TEMPLATE=attenzione, sensore uomo a terra {cam_name} non attivo
#SERENA_ANNOUNCE_FAULT_INTERVAL_S=300
#SERENA_ANNOUNCE_FAULT_GRACE_S=60
#SERENA_STARTUP_ALARM_MAX_AGE_S=300
