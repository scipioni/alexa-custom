# Disable USB autosuspend for any USB audio-class device (conference
# speakerphones: NewPie, Yealink SP92/BT51, EMEET OfficeCore, ...).
# Without this, Linux suspends the device after inactivity and PipeWire
# reinitializes it on wake, resetting the ALSA mixer to 0% and dropping
# routing mid-session.
#
# Device-level match: udev's usb_id builtin records interface classes in
# ID_USB_INTERFACES (":0101xx:" = USB Audio Control interface).
# TAG+="systemd" + SYSTEMD_USER_WANTS re-runs the audio restore service in the
# user session on every (re)connect: WirePlumber can bring a replugged card up
# with an output-only profile (input marked unavailable while a Bluetooth
# dongle relinks), and the restore service is what repairs profile + routing.
ACTION=="add", SUBSYSTEM=="usb", ENV{ID_USB_INTERFACES}=="*:0101*", ATTR{power/autosuspend_delay_ms}="-1", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="alsa-pcm-unmute.service"
# Interface-level fallback for devices where ID_USB_INTERFACES is not populated:
# match the audio-class interface and disable autosuspend on its parent device.
ACTION=="add", SUBSYSTEM=="usb", ATTR{bInterfaceClass}=="01", RUN+="/bin/sh -c 'echo -1 > /sys%p/../power/autosuspend_delay_ms 2>/dev/null || true'"
