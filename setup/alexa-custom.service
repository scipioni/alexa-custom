[Unit]
Description=alexa-custom LiveKit voice client
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h/alexa-custom
ExecStartPre=-/usr/bin/amixer -c 0 sset PCM 100%
ExecStartPre=-/usr/bin/amixer -c NewPie sset PCM 100%
ExecStartPre=-/usr/bin/wpctl set-volume @DEFAULT_SINK@ 1.0
ExecStart=%h/alexa-custom/.venv/bin/alexa-client
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=LANG=it

[Install]
WantedBy=default.target
