[Unit]
Description=Restore NewPie PCM volume and routing after PipeWire fully initialises
After=wireplumber.service

[Service]
Type=oneshot
# 1. Wait for NewPie to appear in the PipeWire graph.
# 2. Restart WirePlumber so pipewire-pulse re-registers all cards and the
#    NewPie source becomes visible to pulsectl (pactl list sources).
#    Without this restart, WirePlumber may expose the card to wpctl but not
#    to the PulseAudio compat layer at boot time.
# 3. Wait for NewPie to reappear after the WirePlumber restart.
# 4. Set output:analog-stereo+input:analog-stereo profile — exposes BOTH a
#    sink and source under Sources/Sinks so PulseAudio clients (parec, pulsesrc)
#    can wake the nodes. pro-audio puts nodes under Filters; PulseAudio clients
#    connect but the node stays suspended and emits no audio.
# 5. Set default routing dynamically from pactl, then restore PCM for 20 s to
#    catch WirePlumber's late ACP profile reset.
ExecStart=/bin/bash -c '\
  for i in $(seq 1 30); do \
    if pactl list cards short 2>/dev/null | grep -qi NewPie; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  systemctl --user restart wireplumber; \
  sleep 3; \
  for i in $(seq 1 15); do \
    if pactl list cards short 2>/dev/null | grep -qi NewPie; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  CARD=$(pactl list cards short | grep -i NewPie | cut -f2 | head -1); \
  [ -n "$CARD" ] && pactl set-card-profile "$CARD" output:analog-stereo+input:analog-stereo 2>/dev/null || true; \
  sleep 2; \
  SINK=$(pactl list sinks short | awk '"'"'/[Nn]ew[Pp]ie/ && !/monitor/{print $2; exit}'"'"'); \
  SOURCE=$(pactl list sources short | awk '"'"'/[Nn]ew[Pp]ie/ && !/monitor/{print $2; exit}'"'"'); \
  [ -n "$SINK" ] && pw-metadata -n default 0 default.configured.audio.sink \
    "{\"name\":\"$SINK\"}" "Spa:String:JSON"; \
  [ -n "$SOURCE" ] && pw-metadata -n default 0 default.configured.audio.source \
    "{\"name\":\"$SOURCE\"}" "Spa:String:JSON"; \
  for i in $(seq 1 10); do \
    CARD_NUM=$(grep -m1 "NewPie" /proc/asound/cards | awk "{print \$1}"); \
    amixer -c "${CARD_NUM:-0}" sset PCM 100%% 2>/dev/null || amixer -c "${CARD_NUM:-0}" sset Playback\ Volume 100%% 2>/dev/null || true; \
    sleep 2; \
  done'
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=default.target
