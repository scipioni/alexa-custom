[Unit]
Description=Restore NewPie PCM volume and routing after PipeWire fully initialises
After=wireplumber.service

[Service]
Type=oneshot
# 1. Wait for NewPie to appear in the PipeWire graph.
# 2. Restart WirePlumber so pipewire-pulse re-registers all cards and the
#    NewPie source becomes visible to pulsectl (pactl list sources).
#    Without this restart, WirePlumber may expose the card to wpctl but not
#    to the PulseAudio compat layer at boot time.
# 3. Wait for NewPie to reappear after the WirePlumber restart.
# 4. Set analog-stereo profile, default routing, and keep restoring PCM for
#    20 s to catch WirePlumber's late ACP profile reset.
ExecStart=/bin/bash -c '\
  for i in $(seq 1 30); do \
    if wpctl status 2>/dev/null | grep -q "NewPie"; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  systemctl --user restart wireplumber; \
  sleep 3; \
  for i in $(seq 1 15); do \
    if pactl list sources short 2>/dev/null | grep -q "NewPie"; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  pactl set-card-profile alsa_card.usb-0a12_NewPie_SABINESMICDFU-00 output:analog-stereo+input:analog-stereo 2>/dev/null || true; \
  sleep 2; \
  pw-metadata -n default 0 default.configured.audio.sink \
    '"'"'{"name":"alsa_output.usb-0a12_NewPie_SABINESMICDFU-00.analog-stereo"}'"'"' "Spa:String:JSON"; \
  pw-metadata -n default 0 default.configured.audio.source \
    '"'"'{"name":"alsa_input.usb-0a12_NewPie_SABINESMICDFU-00.analog-stereo"}'"'"' "Spa:String:JSON"; \
  for i in $(seq 1 10); do \
    amixer -c 0 sset PCM 100%%; \
    sleep 2; \
  done'
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=default.target
