[Unit]
Description=Restore USB audio PCM volume and routing after PipeWire fully initialises
After=wireplumber.service

[Service]
Type=oneshot
# 1. Wait for a supported USB audio device (NewPie or Yealink) to appear.
# 2. Restart WirePlumber so pipewire-pulse re-registers all cards and the
#    source becomes visible to pulsectl (pactl list sources).
# 3. Wait for the device to reappear after the WirePlumber restart.
#    For Yealink: additionally poll pactl list sources until the source node
#    is visible — this confirms WirePlumber applied output:analog-stereo+
#    input:mono-fallback from its state file (profile application is async
#    and was the root cause of boot-time source-invisible failures).
# 4. Set the correct profile:
#    - NewPie:  output:analog-stereo+input:analog-stereo (nodes appear under
#               Sources/Sinks so PulseAudio clients can wake them); fall back
#               to input:analog-stereo if the combined profile is unavailable.
#    - Yealink: no pactl here — WirePlumber already reads the correct profile
#               (output:analog-stereo+input:mono-fallback) from its state file
#               (~/.local/state/wireplumber/default-profile) on restart.
#               Calling pactl set-card-profile pro-audio would overwrite the
#               state file and break boot persistence.
# 5. Set default routing dynamically from pactl, then restore PCM for 20 s to
#    catch WirePlumber's late ACP profile reset.
ExecStart=/bin/bash -c '\
  for i in $(seq 1 30); do \
    if pactl list cards short 2>/dev/null | grep -qiE "NewPie|Yealink"; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  systemctl --user restart wireplumber; \
  sleep 3; \
  for i in $(seq 1 15); do \
    if pactl list cards short 2>/dev/null | grep -qiE "NewPie|Yealink"; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  NEWPIE_CARD=$(pactl list cards short | grep -i NewPie | cut -f2 | head -1); \
  YEALINK_CARD=$(pactl list cards short | grep -i Yealink | cut -f2 | head -1); \
  if [ -n "$NEWPIE_CARD" ]; then \
    pactl set-card-profile "$NEWPIE_CARD" output:analog-stereo+input:analog-stereo 2>/dev/null || \
    pactl set-card-profile "$NEWPIE_CARD" input:analog-stereo 2>/dev/null || true; \
    sleep 2; \
  fi; \
  if [ -n "$YEALINK_CARD" ]; then \
    for i in $(seq 1 20); do \
      if pactl list sources short 2>/dev/null | grep -iE "Yealink" | grep -qv "monitor"; then \
        break; \
      fi; \
      sleep 1; \
    done; \
  fi; \
  SINK=$(pactl list sinks short | grep -iE "NewPie|Yealink" | grep -v "monitor" | cut -f2 | head -1); \
  SOURCE=$(pactl list sources short | grep -iE "NewPie|Yealink" | grep -v "monitor" | cut -f2 | head -1); \
  [ -n "$SINK" ] && pw-metadata -n default 0 default.configured.audio.sink \
    "{\"name\":\"$SINK\"}" "Spa:String:JSON"; \
  [ -n "$SOURCE" ] && pw-metadata -n default 0 default.configured.audio.source \
    "{\"name\":\"$SOURCE\"}" "Spa:String:JSON"; \
  for i in $(seq 1 10); do \
    CARD_NUM=$(grep -m1 -E "NewPie|Yealink" /proc/asound/cards | awk "{print \$1}"); \
    amixer -c "${CARD_NUM:-0}" sset PCM 100%% 2>/dev/null || amixer -c "${CARD_NUM:-0}" sset Playback\ Volume 100%% 2>/dev/null || true; \
    amixer -c "${CARD_NUM:-0}" sset Capture 100%% unmute 2>/dev/null || amixer -c "${CARD_NUM:-0}" sset Mic 100%% unmute 2>/dev/null || amixer -c "${CARD_NUM:-0}" sset Capture\ Volume 100%% unmute 2>/dev/null || amixer -c "${CARD_NUM:-0}" sset Headset 100%% unmute 2>/dev/null || true; \
    [ -n "$SOURCE" ] && pactl set-source-volume "$SOURCE" 100%% 2>/dev/null || true; \
    sleep 2; \
  done'
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=default.target
