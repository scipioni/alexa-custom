[Unit]
Description=Disable USB autosuspend for NewPie speakerphone (runs after boot, not at enumeration)
After=multi-user.target

[Service]
Type=oneshot
# Poll until NewPie appears in sysfs, then disable autosuspend.
# Running after multi-user.target avoids the early-boot power spike that
# caused the board to reset when the device was connected at power-on.
ExecStart=/bin/bash -c '\
  for i in $(seq 1 30); do \
    for dev in /sys/bus/usb/devices/*/; do \
      [ "$(cat "$dev/idVendor" 2>/dev/null)" = "0a12" ] || continue; \
      [ "$(cat "$dev/idProduct" 2>/dev/null)" = "1260" ] || continue; \
      echo -1 > "$dev/power/autosuspend_delay_ms"; \
      echo on > "$dev/power/control"; \
      echo "NewPie autosuspend disabled: $dev"; \
      exit 0; \
    done; \
    sleep 1; \
  done; \
  echo "NewPie not found after 30s, skipping"'
RemainAfterExit=yes
TimeoutStartSec=35

[Install]
WantedBy=multi-user.target
