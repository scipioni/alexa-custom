[Unit]
Description=Disable USB autosuspend for USB audio devices (runs after boot, not at enumeration)
After=multi-user.target

[Service]
Type=oneshot
# Poll until a USB device with an audio-class (01) interface appears in sysfs,
# then disable autosuspend on it. Device-agnostic: covers any UAC speakerphone.
# Running after multi-user.target avoids the early-boot power spike that
# caused the board to reset when the device was connected at power-on.
ExecStart=/bin/bash -c '\
  for i in $(seq 1 30); do \
    found=0; \
    for intf in /sys/bus/usb/devices/*:*/bInterfaceClass; do \
      [ -f "$intf" ] || continue; \
      [ "$(cat "$intf")" = "01" ] || continue; \
      dev="/sys/bus/usb/devices/$(basename "$(dirname "$intf")" | cut -d: -f1)"; \
      echo -1 > "$dev/power/autosuspend_delay_ms" 2>/dev/null; \
      echo on > "$dev/power/control" 2>/dev/null; \
      echo "USB audio autosuspend disabled: $dev"; \
      found=1; \
    done; \
    [ "$found" = 1 ] && exit 0; \
    sleep 1; \
  done; \
  echo "no USB audio device found after 30s, skipping"'
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
